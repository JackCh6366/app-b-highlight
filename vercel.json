{
  "functions": {
    "api/summarize.ts": {
      "maxDuration": 60
    },
    "api/summarize-long.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/parse-pdf.ts": {
      "maxDuration": 30
    },
    "api/parse-doc.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

